{% comment %} Config for the injector (no visible markup — card is created in JS). {% endcomment %}
<script
  type="application/json"
  id="wm-mockup-cta-config"
>
{
  "app": {{ mockup_app | json }},
  "returnUrl": {{ mockup_return | json }}
}
</script>

<script>
/**
 * Weatherman Mockup CTA injector
 * Finds Qikify Section 4 / file upload and inserts `.wm-mockup-cta` above it.
 * Survives Qikify re-renders via MutationObserver (same resilience model as Guard v4).
 */
(function () {
  'use strict';

  if (window.__wmMockupCtaInjectorV1) return;
  window.__wmMockupCtaInjectorV1 = true;

  var CTA_ID = 'wm-mockup-cta-root';
  var CTA_MARK = 'data-wm-mockup-cta';
  var PLACE_RETRY_MS = 400;
  var placeTimer = null;

  function readConfig() {
    var el = document.getElementById('wm-mockup-cta-config');
    var fallback = {
      app: 'https://virtual-mockup-85kxgyfvpa82a669bqjuqg.streamlit.app',
      returnUrl: '',
    };
    if (!el) return fallback;
    try {
      var parsed = JSON.parse(el.textContent || '{}');
      return {
        app: String(parsed.app || fallback.app),
        returnUrl: String(parsed.returnUrl || ''),
      };
    } catch (e) {
      return fallback;
    }
  }

  function buildHref(cfg) {
    var base = cfg.app.replace(/\/$/, '');
    var href = base + '/?mode=customer';
    if (cfg.returnUrl) {
      href += '&return=' + encodeURIComponent(cfg.returnUrl);
    }
    return href;
  }

  function textOf(el) {
    return (el.textContent || '').replace(/\s+/g, ' ').trim();
  }

  function isOurCta(el) {
    return !!(el && (el.id === CTA_ID || (el.closest && el.closest('#' + CTA_ID))));
  }

  /** Prefer Qikify / bcontact file inputs; fall back to first file input on the page. */
  function findFileInput() {
    var selectors = [
      '[class*="bcontact"] input[type="file"]',
      '.bcontact-field input[type="file"]',
      'form [class*="upload"] input[type="file"]',
      'form [class*="file"] input[type="file"]',
      'input[type="file"]',
    ];
    for (var i = 0; i < selectors.length; i++) {
      var list = document.querySelectorAll(selectors[i]);
      for (var j = 0; j < list.length; j++) {
        if (!isOurCta(list[j])) return list[j];
      }
    }
    return null;
  }

  /** Heading / label for Section 4 Artwork Upload. */
  function findArtworkHeading() {
    var nodes = document.querySelectorAll(
      'h1, h2, h3, h4, h5, h6, legend, label, p, span, div, strong'
    );
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      if (isOurCta(el)) continue;
      if (el.children && el.children.length > 4) continue;
      var t = textOf(el);
      if (!t || t.length > 80) continue;
      if (
        /^4[\.\):\-\s]+artwork\s*upload/i.test(t) ||
        /^artwork\s*upload$/i.test(t) ||
        /^optional:\s*upload logos/i.test(t)
      ) {
        return el;
      }
    }
    return null;
  }

  function hostForFile(input) {
    if (!input) return null;
    return (
      (input.closest &&
        input.closest(
          '.bcontact-field, [class*="bcontact-field"], [class*="upload"], [class*="file-upload"], [class*="file_field"], form > div, fieldset'
        )) ||
      input.parentElement
    );
  }

  /**
   * Element before which we insert the CTA.
   * Prefer the upload field host; else the Artwork Upload heading block.
   */
  function findAnchor() {
    var input = findFileInput();
    if (input) {
      var host = hostForFile(input);
      if (host && host.parentNode) return host;
      return input;
    }
    var heading = findArtworkHeading();
    if (!heading) return null;
    var block =
      (heading.closest &&
        heading.closest(
          '.bcontact-field, [class*="bcontact"], [class*="field"], fieldset, section, form > div'
        )) ||
      heading;
    return block.parentNode ? block : heading;
  }

  function buildCtaElement(cfg) {
    var root = document.createElement('div');
    root.id = CTA_ID;
    root.className = 'wm-mockup-cta';
    root.setAttribute(CTA_MARK, '1');
    root.setAttribute('role', 'region');
    root.setAttribute('aria-label', 'Artwork options');

    root.innerHTML =
      '<h3>Artwork — choose one</h3>' +
      '<p><strong>Option A — Upload your vector logo.</strong> ' +
      'Use the Artwork Upload field below. Accepted: .AI, .EPS, .CDR, .PDF, or .SVG ' +
      '(PNG, JPG, and other raster types are blocked).</p>' +
      '<p><strong>Option B — Create a live visual mockup.</strong> ' +
      'Open our Virtual Mockup Creator, stamp your logo on Weatherman gear, download the PDF proof, ' +
      'then upload that PDF (and/or your original vector logo) in Artwork Upload below.</p>' +
      '<ol>' +
      '<li>Click <em>Create a mockup</em> (opens in a new tab).</li>' +
      '<li>Upload your vector logo, pick product and colors, generate the PDF.</li>' +
      '<li>Download the PDF, return here, and attach it under Artwork Upload.</li>' +
      '<li>Finish the rest of this form and Submit.</li>' +
      '</ol>' +
      '<a class="wm-mockup-btn" target="_blank" rel="noopener noreferrer">Create a mockup</a>' +
      '<p class="wm-mockup-note">After you download your proof, come back to this tab to upload files and submit your inquiry. ' +
      'Mockup PDFs are accepted by the Artwork field (.PDF).</p>';

    var link = root.querySelector('a.wm-mockup-btn');
    if (link) link.setAttribute('href', buildHref(cfg));
    return root;
  }

  function alreadyCorrectlyPlaced(cta, anchor) {
    return !!(cta && anchor && cta.nextElementSibling === anchor && cta.parentNode === anchor.parentNode);
  }

  function placeCta() {
    var anchor = findAnchor();
    if (!anchor || !anchor.parentNode) return false;

    var cfg = readConfig();
    var cta = document.getElementById(CTA_ID);

    if (alreadyCorrectlyPlaced(cta, anchor)) {
      var link = cta.querySelector('a.wm-mockup-btn');
      if (link) link.setAttribute('href', buildHref(cfg));
      return true;
    }

    if (!cta) {
      cta = buildCtaElement(cfg);
    } else {
      var existingLink = cta.querySelector('a.wm-mockup-btn');
      if (existingLink) existingLink.setAttribute('href', buildHref(cfg));
    }

    try {
      anchor.parentNode.insertBefore(cta, anchor);
      return true;
    } catch (e) {
      return false;
    }
  }

  function schedulePlace() {
    if (placeTimer) return;
    placeTimer = setTimeout(function () {
      placeTimer = null;
      placeCta();
    }, PLACE_RETRY_MS);
  }

  function boot() {
    placeCta();
    // Qikify often mounts fields after first paint / step changes.
    setTimeout(placeCta, 200);
    setTimeout(placeCta, 800);
    setTimeout(placeCta, 2000);

    var obs = new MutationObserver(function () {
      var anchor = findAnchor();
      var cta = document.getElementById(CTA_ID);
      if (!anchor) return;
      if (!cta || !alreadyCorrectlyPlaced(cta, anchor)) schedulePlace();
    });
    obs.observe(document.documentElement, { childList: true, subtree: true });

    document.addEventListener('bcontact:fileUploaded', schedulePlace, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>

<script>
/**
 * Vector Upload Guard v4
 * Blocks non-vector uploads on Qikify forms (theme-only; does not edit Qikify).
 *
 * Error UI is attached to document.body (fixed), so Qikify's re-render cannot wipe it.
 *
 * Allowed: .ai .eps .cdr .pdf .svg
 */
(function () {
  'use strict';

  if (window.__vectorUploadGuardV4) return;
  window.__vectorUploadGuardV4 = true;

  var ALLOWED = ['ai', 'eps', 'cdr', 'pdf', 'svg'];
  var ACCEPT = '.' + ALLOWED.join(',.');
  var MSG =
    'Please upload a vector file (.ai, .eps, .cdr, .pdf, or .svg). PNG, JPG, TXT, and other file types cannot be used.';
  var MARK = 'data-vector-upload-guard';
  var ERROR_ID = 'vector-upload-guard-error';

  var showErrorPending = false;

  function ext(name) {
    if (!name || name.indexOf('.') === -1) return '';
    return name.split('.').pop().toLowerCase().trim();
  }

  function allowedName(name) {
    return ALLOWED.indexOf(ext(name)) !== -1;
  }

  function allowedFile(file) {
    return !!(file && allowedName(file.name));
  }

  function fileInput() {
    return document.querySelector('input[type="file"]');
  }

  function paintError() {
    if (!showErrorPending) return;

    var input = fileInput();
    var top = 100;
    if (input) {
      var rect = input.getBoundingClientRect();
      top = Math.max(12, Math.round(rect.bottom + 10));
    }

    var el = document.getElementById(ERROR_ID);
    if (!el) {
      el = document.createElement('div');
      el.id = ERROR_ID;
      el.setAttribute(MARK + '-error', 'true');
      el.setAttribute('role', 'alert');
      document.body.appendChild(el);
    }

    el.textContent = MSG;
    el.style.cssText = [
      'position:fixed',
      'left:50%',
      'transform:translateX(-50%)',
      'top:' + top + 'px',
      'z-index:2147483647',
      'max-width:560px',
      'width:calc(100% - 32px)',
      'box-sizing:border-box',
      'color:#b42318',
      'background:#fef3f2',
      'border:1px solid #fecdca',
      'border-radius:8px',
      'padding:12px 14px',
      'font-size:14px',
      'font-weight:700',
      'line-height:1.4',
      'font-family:system-ui,-apple-system,sans-serif',
      'box-shadow:0 8px 24px rgba(0,0,0,.18)',
      'pointer-events:none',
      'display:block',
    ].join(';');

    if (input && typeof input.scrollIntoView === 'function') {
      try {
        input.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch (e) {
        input.scrollIntoView(true);
      }
    }
  }

  function hideError() {
    showErrorPending = false;
    var el = document.getElementById(ERROR_ID);
    if (el) el.remove();
  }

  function clearInput(input) {
    try {
      input.value = '';
    } catch (e) {}
  }

  function hostFor(el) {
    return (
      (el &&
        el.closest &&
        el.closest(
          '.bcontact-field, [class*="bcontact"], [class*="file"], [class*="upload"], form, div'
        )) ||
      (el && el.parentElement) ||
      document.body
    );
  }

  function clickRemoveNear(root) {
    if (!root || !root.querySelectorAll) return false;
    var candidates = root.querySelectorAll(
      'button, a, span, i, svg, [role="button"], [class*="remove"], [class*="close"], [class*="delete"]'
    );
    for (var i = 0; i < candidates.length; i++) {
      var el = candidates[i];
      var label = (
        (el.getAttribute &&
          (el.getAttribute('aria-label') ||
            el.getAttribute('title') ||
            el.getAttribute('class'))) ||
        ''
      ).toLowerCase();
      var text = (el.textContent || '').trim();
      if (
        text === '×' ||
        text === 'x' ||
        text === 'X' ||
        label.indexOf('remove') !== -1 ||
        label.indexOf('close') !== -1 ||
        label.indexOf('delete') !== -1
      ) {
        try {
          el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
          return true;
        } catch (e) {
          try {
            el.click();
            return true;
          } catch (e2) {}
        }
      }
    }
    return false;
  }

  function stripBadFileChips(root) {
    var scope = root || document;
    var nodes = scope.querySelectorAll('a, span, div, p, li, button');
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      if (el.id === ERROR_ID) continue;
      var text = (el.textContent || '').trim();
      if (!text || text.length > 120) continue;
      if (!/^[^\s\\/]+\.[a-z0-9]{2,5}$/i.test(text)) continue;
      if (allowedName(text)) continue;

      var wrap = hostFor(el);
      clickRemoveNear(wrap) || clickRemoveNear(el.parentElement);
      var input = wrap.querySelector('input[type="file"]');
      if (input) clearInput(input);
      showErrorPending = true;
      paintError();
    }
  }

  function enhance(input) {
    if (!input || input.getAttribute(MARK) === '1') return;
    input.setAttribute(MARK, '1');
    try {
      input.setAttribute('accept', ACCEPT);
    } catch (e) {}
  }

  function enhanceAll(root) {
    var list = (root || document).querySelectorAll('input[type="file"]');
    for (var i = 0; i < list.length; i++) enhance(list[i]);
  }

  function reject(input) {
    showErrorPending = true;
    clearInput(input);
    clickRemoveNear(hostFor(input));
    paintError();
    setTimeout(paintError, 50);
    setTimeout(paintError, 200);
    setTimeout(function () {
      stripBadFileChips(document);
      paintError();
    }, 400);
  }

  function onChangeCapture(e) {
    var input = e.target;
    if (!input || input.tagName !== 'INPUT' || input.type !== 'file') return;
    enhance(input);

    var files = input.files;
    if (!files || !files.length) return;

    for (var i = 0; i < files.length; i++) {
      if (!allowedFile(files[i])) {
        e.stopImmediatePropagation();
        e.preventDefault();
        reject(input);
        return;
      }
    }

    hideError();
  }

  function onDropCapture(e) {
    var dt = e.dataTransfer;
    if (!dt || !dt.files || !dt.files.length) return;
    var t = e.target;
    if (!t || !t.closest) return;
    if (
      !t.closest('input[type="file"]') &&
      !t.closest('[class*="file"]') &&
      !t.closest('[class*="upload"]') &&
      !t.closest('[class*="bcontact"]')
    ) {
      return;
    }
    for (var i = 0; i < dt.files.length; i++) {
      if (!allowedFile(dt.files[i])) {
        e.stopImmediatePropagation();
        e.preventDefault();
        showErrorPending = true;
        paintError();
        setTimeout(function () {
          stripBadFileChips(document);
          paintError();
        }, 150);
        return;
      }
    }
    hideError();
  }

  function onSubmitCapture(e) {
    var form = e.target;
    if (!form || form.tagName !== 'FORM') return;
    var inputs = form.querySelectorAll('input[type="file"]');
    for (var i = 0; i < inputs.length; i++) {
      var files = inputs[i].files;
      if (!files) continue;
      for (var j = 0; j < files.length; j++) {
        if (!allowedFile(files[j])) {
          e.preventDefault();
          e.stopImmediatePropagation();
          reject(inputs[i]);
          return;
        }
      }
    }
  }

  function onQikifyUploaded() {
    setTimeout(function () {
      stripBadFileChips(document);
      paintError();
    }, 0);
    setTimeout(function () {
      stripBadFileChips(document);
      paintError();
    }, 200);
  }

  function onScrollOrResize() {
    if (showErrorPending) paintError();
  }

  function boot() {
    enhanceAll(document);

    document.addEventListener('change', onChangeCapture, true);
    document.addEventListener('drop', onDropCapture, true);
    document.addEventListener('submit', onSubmitCapture, true);
    document.addEventListener('bcontact:fileUploaded', onQikifyUploaded, true);
    window.addEventListener('scroll', onScrollOrResize, true);
    window.addEventListener('resize', onScrollOrResize);

    var obs = new MutationObserver(function () {
      enhanceAll(document);
      if (showErrorPending) {
        if (!document.getElementById(ERROR_ID)) paintError();
        stripBadFileChips(document);
      }
    });
    obs.observe(document.documentElement, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
